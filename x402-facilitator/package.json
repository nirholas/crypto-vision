{
  "name": "@sperax/x402-facilitator",
  "version": "1.0.0",
  "description": "x402 payment facilitator — verifies and settles EIP-3009 USDC micropayments on Base, Arbitrum, and Ethereum",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.7.6",
    "hono": "^4.13.11",
    "lru-cache": "^11.2.7",
    "viem": "^2.21.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node": "^0.16.8",
      "esbuild": "^0.28.1",
      "nanoid@<3.3.12": "^3.3.12",
      "postcss": "^8.5.23",
      "tinypool": "^2.1.2",
      "vite": "^7.3.3",
      "ws@^8": "^8.21.0"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/x402-facilitator"
  },
  "keywords": [
    "x402",
    "facilitator",
    "micropayments",
    "USDC",
    "EIP-3009",
    "Base",
    "DeFi"
  ]
}
